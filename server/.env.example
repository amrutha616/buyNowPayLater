JWT_SECRET=replace_with_a_64_plus_char_random_secret
RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
